<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender: clean one-line format -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%cyan(%d{HH:mm:ss}) %highlight(%-5level) [%thread] %magenta(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Application packages -->
    <logger name="com.bookingsystem" level="DEBUG"/>

    <!-- Spring framework: keep quiet -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.boot.web" level="INFO"/>

    <!-- Hibernate: suppress SQL noise (toggle to DEBUG to re-enable) -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.SQL" level="OFF"/>
    <logger name="org.hibernate.type.descriptor.sql" level="OFF"/>

    <!-- Other middleware -->
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.apache.catalina" level="WARN"/>
    <logger name="org.apache.tomcat" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
